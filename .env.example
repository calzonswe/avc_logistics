# AVC Management App - Environment Variables
# Copy to .env and fill in values

# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avc_management
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# API
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (optional - for future notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@avc.local

# Feature Flags
ENABLE_OFFLINE_SYNC=true
ENABLE_MAP_EDITOR=true
ENABLE_MAINTENANCE_SCHEDULER=true

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true