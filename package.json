{
  "name": "avc-management-app",
  "version": "0.0.0",
  "private": true,
  "description": "AVC Recycling Logistics System - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@avc/api",
    "build:web": "turbo run build --filter=@avc/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@avc/api",
    "test:web": "turbo run test --filter=@avc/web",
    "db:migrate": "pnpm --filter @avc/api db:migrate",
    "db:seed": "pnpm --filter @avc/api db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.0",
    "esbuild": "0.21.5",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.16.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}