# Production environment (copy to .env.production and fill in the real values).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Every secret below must be real — the compose file refuses to start without
# JWT_SECRET, POSTGRES_PASSWORD, CORS_ORIGIN and WEB_URL.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=avc_management
POSTGRES_USER=postgres
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Application ------------------------------------------------------------
# Generate: openssl rand -base64 48  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# The public https origin of the app (the external reverse proxy).
# CORS_ORIGIN is a comma separated list of allowed origins.
CORS_ORIGIN=https://avc.example.com
WEB_URL=https://avc.example.com

# --- Web push (ticket 13) ---------------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
# Without the keys web push is disabled (the in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Logging / ports --------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
# The port the web container publishes (the TLS proxy points here).
WEB_PORT=8080
